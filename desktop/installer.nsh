!macro MediaConvertMenu KEY ARG
  WriteRegStr HKCU "Software\Classes\${KEY}\shell\MediaConvert" "" "Convert with MediaConvert"
  WriteRegStr HKCU "Software\Classes\${KEY}\shell\MediaConvert" "Icon" "$INSTDIR\${APP_EXECUTABLE_FILENAME},0"
  WriteRegStr HKCU "Software\Classes\${KEY}\shell\MediaConvert" "MultiSelectModel" "Player"
  WriteRegStr HKCU "Software\Classes\${KEY}\shell\MediaConvert\command" "" '$\"$INSTDIR\${APP_EXECUTABLE_FILENAME}$\" --convert $\"${ARG}$\"'
!macroend

!macro customInstall
  !insertmacro MediaConvertMenu "SystemFileAssociations\.mp4" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.mov" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.mkv" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.webm" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.avi" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.gif" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.mp3" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.wav" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.flac" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.aac" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.m4a" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.ogg" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.opus" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.wmv" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.flv" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.ts" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.3gp" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.wma" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.aiff" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.aif" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.hevc" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.m2ts" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.mts" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.mpeg" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.mpg" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.m4v" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.mka" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.oga" "%1"
  !insertmacro MediaConvertMenu "SystemFileAssociations\.vob" "%1"
  !insertmacro MediaConvertMenu "Directory" "%1"
  !insertmacro MediaConvertMenu "Directory\Background" "%V"
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend

!macro customUnInstall
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mp4\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mov\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mkv\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.webm\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.avi\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.gif\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mp3\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.wav\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.flac\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.aac\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m4a\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ogg\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.opus\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.wmv\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.flv\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ts\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.3gp\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.wma\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.aiff\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.aif\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.hevc\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m2ts\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mts\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mpeg\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mpg\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m4v\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mka\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.oga\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.vob\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\Directory\shell\MediaConvert"
  DeleteRegKey HKCU "Software\Classes\Directory\Background\shell\MediaConvert"
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend
